# Leadership sign-in for the business profile editor.
#
# Copy the values into the deployment's environment (and into a local,
# gitignored `.dev.vars` for `npm run dev`). Until all three are set, the
# business profile screen shows a configuration notice and nobody can edit it —
# the employee call-out flow is unaffected and stays anonymous.

# --- Clerk (shared staff SSO) ---
# Use the SAME Clerk application as Performance Pulse, so one work account signs
# in to both. Both values must belong to that same Clerk app.

# Public browser key, served at runtime by /api/auth/clerk/config.
# Deliberately NOT named NEXT_PUBLIC_*: the framework inlines those into the
# bundle at build time, which would pin one build to one Clerk instance.
# (NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY still works as a fallback.)
CLERK_PUBLISHABLE_KEY=

# Secret. Never expose this to the browser or commit it.
CLERK_SECRET_KEY=

# Who may edit the business profile. One address, or several separated by
# commas. Matching ignores case and surrounding whitespace. Each address must
# exist in the Clerk application above.
SUPER_ADMIN_EMAIL=
